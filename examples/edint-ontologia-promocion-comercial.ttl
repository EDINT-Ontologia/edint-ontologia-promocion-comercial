@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edintcom: <https://edint.es/def/censo-locales#> .
@prefix edintkoaccCamtype: <https://edint.es/kos/CommercialCampaignType/> .
@prefix edintkoacctype: <https://edint.es/kos/CommercialEventType/> .
@prefix edintpro: <https://edint.es/def/promocion-comercial#> .
@prefix edintzone: <https://edint.es/def/zona-regulatoria#> .
@prefix ex: <https://example.org/recurso/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix esadm: <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:CAMP-2025-CH-001
  a edintpro:CommercialCampaign;
  dcterms:identifier "CAMP-2025-CH-001";
  rdfs:comment "Evento local de dinamización comercial en la zona gastronómica del Mercado de Chamberí, tomando como referencia la oferta real de restauración del mercado y sus horarios de servicio.";
  schema:endDate "2025-06-08T16:30:00"^^xsd:dateTime;
  schema:startDate "2025-06-06T12:30:00"^^xsd:dateTime;
  edintpro:includesCommercialSpace ex:COM-CH-0001;
  edintpro:numberOfCommercialSpaces 1;
  edintpro:locatedInZone ex:ZONA-CHAMBERI-001;
  edintpro:hasCommercialCampaignType edintkoaccCamtype:Revitalization;
  rdfs:label "Semana Gastronómica Mercado de Chamberí 2025" .

ex:COM-CH-0001 a
    edintcom:CommercialSpace;
  edintpro:locatedInZone ex:ZONA-CHAMBERI-001 .

ex:EV-2025-CH-001
  a edintpro:CommercialEvent;
  dcterms:identifier "EV-2025-CH-001";
  schema:endDate "2025-06-08T16:30:00"^^xsd:dateTime;
  schema:startDate "2025-06-06T12:30:00"^^xsd:dateTime;
  edintpro:hasCommercialEventType edintkoacctype:LocalEvent;
  edintpro:locatedInZone ex:ZONA-CHAMBERI-001;
  rdfs:comment "Evento local de dinamización comercial en la zona gastronómica del Mercado de Chamberí, tomando como referencia la oferta real de restauración del mercado y sus horarios de servicio.";
  rdfs:label "Semana Gastronómica Mercado de Chamberí 2025" .

ex:ZONA-CHAMBERI-001 a edintzone:EconomicInterestZone;
  dcterms:identifier "ZONA-CHAMBERI-001";
  esadm:municipio ex:MADRID;
  geosparql:hasGeometry ex:ZONA-CHAMBERI-001-geometry;
  rdfs:comment "Zona de interés económico asociada al Mercado de Chamberí, mercado tradicional de Madrid con origen en 1876 y reinaugurado en 1943, con accesos por Alonso Cano, García de Paredes y Viriato, y con presencia de restauración y cafetería-pastelería.";
  rdfs:label "Mercado de Chamberí" .

ex:MADRID a esadm:Municipio;
  rdfs:label "Ayuntamiento de Madrid"@es .

ex:CAMP-2026-USERA-001
  a edintpro:CommercialCampaign;
  dcterms:identifier "CAMP-2026-USERA-001";
  rdfs:comment "Campaña de revitalización del comercio de proximidad en el eje comercial de la calle Marcelo Usera, con participación de los mercados municipales y de las tiendas de barrio tradicionales.";
  schema:endDate "2026-10-08T16:30:00"^^xsd:dateTime;
  schema:startDate "2026-10-06T12:30:00"^^xsd:dateTime;
  edintpro:includesCommercialSpace ex:COM-USERA-0001, ex:COM-USERA-0002;
  edintpro:numberOfCommercialSpaces 30;
  edintpro:locatedInZone ex:ZONA-USERA-001;
  edintpro:hasCommercialCampaignType edintkoaccCamtype:Revitalization;
  rdfs:label "Usera Próxima" .

ex:COM-USERA-0001 a edintcom:CommercialSpace;
  edintpro:locatedInZone ex:ZONA-USERA-001 .

ex:COM-USERA-0002 a edintcom:CommercialSpace;
  edintpro:locatedInZone ex:ZONA-USERA-001 .

ex:ZONA-USERA-001 a edintzone:EconomicInterestZone;
  dcterms:identifier "ZONA-USERA-001";
  esadm:municipio ex:MADRID;
  geosparql:hasGeometry ex:ZONA-USERA-001-geometry;
  rdfs:comment "Zona de interés económico de la calle de Marcelo Usera, eje comercial del distrito: concentra comercio tradicional junto a negocios de la comunidad china, restaurantes, panaderías asiáticas y servicios de proximidad.";
  rdfs:label "Calle de Marcelo Usera" .
