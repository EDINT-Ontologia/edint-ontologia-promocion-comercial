                                                                                              "Ontología EDINT de Promoción Comercial. EDINT. Revisión: v0.2.1."@es ;
                                             <http://purl.org/dc/terms/created> "2026-04-15"^^xsd:date ;
                                             <http://purl.org/dc/terms/creator> _:genid1 ,
                                                                                _:genid2 ,
